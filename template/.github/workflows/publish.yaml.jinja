name: Publish to Package Registry

on:
  workflow_dispatch:
    inputs:
      publish_to_primary:
        description: 'Publish to Primary Registry (expects stable version in package.json, no pre-release identifier)'
        type: boolean
        required: false
        default: false

env:
  PRE_COMMIT_HOME: {% raw %}${{ github.workspace }}{% endraw %}/.precommit_cache

permissions:
  id-token: write # needed to assume OIDC roles
  contents: read # need to explicitly provide this whenever defining permissions because the default value is 'none' for anything not explicitly set when permissions are defined

jobs:
  get-values:
    name: Get Values
    timeout-minutes: {{ gha_short_timeout_minutes }}
    runs-on: {{ gha_linux_runner }}
    outputs:
      package-version: {% raw %}${{ steps.compute-versions.outputs.package_version }}{% endraw %}
      staging-version: {% raw %}${{ steps.compute-versions.outputs.staging_version }}{% endraw %}
    steps:
      - name: Checkout code
        uses: actions/checkout@{{ gha_checkout }}

      - name: Setup Node
        uses: ./.github/actions/install_deps
        with:
          node-version: {{ node_version }}
          install-deps: false
          skip-installing-ssm-plugin-manager: true

      - name: Compute versions
        id: compute-versions
        run: |
          BASE=$(npm pkg get version | tr -d '"')
          echo "Package version: $BASE"
          echo "package_version=$BASE" >> $GITHUB_OUTPUT
          # Every staging publish needs a unique version, otherwise the registry rejects a re-run of this workflow.
          echo "staging_version=${BASE}-rc.{% raw %}${{ github.run_number }}{% endraw %}" >> $GITHUB_OUTPUT

  lint:
    name: Pre-commit
    uses: ./.github/workflows/pre-commit.yaml
    permissions:
      contents: write # needed for mutex
      id-token: write # needed to assume OIDC roles
    with:
      python-version: {{ py313_version }}
      setup-node: true
      node-version: {{ node_version }}

  test:
    needs:
      - lint
    strategy:
      matrix:
        os:
          - "{{ gha_linux_runner }}"
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    timeout-minutes: {{ gha_medium_timeout_minutes }}
    steps:
      - name: Checkout code
        uses: actions/checkout@{{ gha_checkout }}

      - name: Install dependencies
        uses: ./.github/actions/install_deps
        with:
          node-version: {{ node_version }}
          skip-installing-ssm-plugin-manager: true

      - name: Prepare module stubs
        run: pnpm dev:prepare

      - name: Run tests
        run: pnpm test-unit

  build:
    needs:
      - test
    timeout-minutes: {{ gha_medium_timeout_minutes }}
    runs-on: {{ gha_linux_runner }}
    steps:
      - name: Checkout code
        uses: actions/checkout@{{ gha_checkout }}

      - name: Install dependencies
        uses: ./.github/actions/install_deps
        with:
          node-version: {{ node_version }}
          skip-installing-ssm-plugin-manager: true

      - name: Build module
        run: pnpm prepack

      - name: Upload built package
        uses: actions/upload-artifact@{{ gha_upload_artifact }}
        with:
          name: npm-package-dist
          path: dist/
          if-no-files-found: error

  publish-to-staging:
    name: Publish to Staging Registry
    needs:
      - build
      - get-values
    timeout-minutes: {{ gha_medium_timeout_minutes }}
    runs-on: {{ gha_linux_runner }}
    steps:
      - name: Checkout code
        uses: actions/checkout@{{ gha_checkout }}

      - name: Install dependencies
        uses: ./.github/actions/install_deps
        with:
          node-version: {{ node_version }}
          skip-installing-ssm-plugin-manager: true

      - name: Download built package
        uses: actions/download-artifact@{{ gha_download_artifact }}
        with:
          name: npm-package-dist
          path: dist/

      - name: Set staging version
        run: pnpm version "{% raw %}${{ needs.get-values.outputs.staging-version }}{% endraw %}" --no-git-tag-version --no-git-checks

{% if npm_package_registry == "AWS CodeArtifact" %}
      - name: OIDC Auth for Publishing to CodeArtifact Staging
        uses: aws-actions/configure-aws-credentials@{{ gha_configure_aws_credentials }}
        with:
          role-to-assume: arn:aws:iam::{{ aws_central_infrastructure_account_id }}:role/GHA-CA-Staging-{{ repo_name }}
          aws-region: {{ aws_org_home_region }}

      - name: Publish to CodeArtifact Staging
        run: |
          . .devcontainer/code-artifact-auth.sh
          pnpm publish --tag rc --no-git-checks --ignore-scripts

{% else %}
      - name: Publish to npm (staging rc tag)
        run: pnpm publish --tag rc --no-git-checks --ignore-scripts{% if is_open_source %} --access public{% endif %}

{% endif %}

  install-from-staging:
    name: Install package from staging registry
    needs:
      - publish-to-staging
      - get-values
    strategy:
      matrix:
        os:
          - "{{ gha_linux_runner }}"
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    timeout-minutes: {{ gha_medium_timeout_minutes }}
    steps:
      - name: Checkout code
        uses: actions/checkout@{{ gha_checkout }}

      - name: Install dependencies
        uses: ./.github/actions/install_deps
        with:
          node-version: {{ node_version }}
          skip-installing-ssm-plugin-manager: true

{% if npm_package_registry == "npm" %}
      - name: Wait for npm and install via pnpm
        shell: bash
        run: |
          set -euo pipefail
          PKG="{{ npm_package_name }}"
          VER="{% raw %}${{ needs.get-values.outputs.staging-version }}{% endraw %}"
          TESTDIR="$RUNNER_TEMP/staging-test"
          mkdir -p "$TESTDIR"
          printf '{"name":"smoke-test","version":"0.0.0","private":true,"dependencies":{"%s":"%s"}}' "$PKG" "$VER" > "$TESTDIR/package.json"
          for i in $(seq 1 60); do
            code="$(curl -fsS -o /dev/null -w '%{http_code}' "https://registry.npmjs.org/${PKG}/${VER}" || true)"
            if [ "$code" = "200" ]; then
              echo "Found ${PKG}@${VER} on npm."
              break
            fi
            echo "Not yet available (attempt $i/60); sleeping 5s..."
            sleep 5
          done
          if [ "$code" != "200" ]; then
            echo "Timeout waiting for ${PKG}@${VER} on npm."
            exit 1
          fi
          cd "$TESTDIR"
          for i in $(seq 1 12); do
            if pnpm install --no-frozen-lockfile --ignore-scripts; then
              echo "Successfully installed ${PKG}@${VER}"
              break
            fi
            echo "Package not yet installable (attempt $i/12); sleeping 10s..."
            sleep 10
          done
          if [ ! -d "node_modules/${PKG}" ]; then
            echo "Timeout waiting for ${PKG}@${VER} to be installable."
            exit 1
          fi

{% else %}
      - name: OIDC Auth for Installing from CodeArtifact Staging
        uses: aws-actions/configure-aws-credentials@{{ gha_configure_aws_credentials }}
        with:
          role-to-assume: arn:aws:iam::{{ aws_central_infrastructure_account_id }}:role/GHA-CA-Staging-{{ repo_name }}
          aws-region: {{ aws_org_home_region }}

      - name: Install from CodeArtifact Staging
        shell: bash
        run: |
          set -euo pipefail
          . .devcontainer/code-artifact-auth.sh
          PKG="{{ npm_package_name }}"
          VER="{% raw %}${{ needs.get-values.outputs.staging-version }}{% endraw %}"
          TESTDIR="$RUNNER_TEMP/staging-test"
          mkdir -p "$TESTDIR"
          printf '{"name":"smoke-test","version":"0.0.0","private":true,"dependencies":{"%s":"%s"}}' "$PKG" "$VER" > "$TESTDIR/package.json"
          cd "$TESTDIR"
          pnpm install --no-frozen-lockfile --ignore-scripts

{% endif %}
      - name: Confirm module version and all export entries
        shell: bash
        run: |
          set -euo pipefail
          VER="{% raw %}${{ needs.get-values.outputs.staging-version }}{% endraw %}"
          PKG_DIR="$RUNNER_TEMP/staging-test/node_modules/{{ npm_package_name }}"
          INSTALLED=$(node -e "console.log(require('$PKG_DIR/package.json').version)")
          echo "Installed version: $INSTALLED (expected $VER)"
          if [ "$INSTALLED" != "$VER" ]; then
            echo "Version mismatch"
            exit 1
          fi
          # A publish can succeed while the tarball omits files, so assert every exports target is present.
          while IFS= read -r f; do
            if [ ! -f "$PKG_DIR/$f" ]; then
              echo "Missing export entry: $f — tarball is incomplete"
              exit 1
            fi
            echo "OK: $f"
          done < <(jq -r '.exports | to_entries[] | .value.import | ltrimstr("./")' "$PKG_DIR/package.json")

  create-tag:
    name: Create the git tag
    # Guarded on the default branch so a feature branch cannot tag or promote a release.
    if: {% raw %}${{ fromJSON(github.event.inputs.publish_to_primary) && github.ref == 'refs/heads/main' }}{% endraw %}
    timeout-minutes: {{ gha_short_timeout_minutes }}
    needs:
      - install-from-staging
    permissions:
      contents: write # needed to push the tag
    runs-on: {{ gha_linux_runner }}
    steps:
      - name: Checkout code
        uses: actions/checkout@{{ gha_checkout }}

      - name: Setup python
        uses: actions/setup-python@{{ gha_setup_python }}
        with:
          python-version: {{ py313_version }}

      - name: Confirm tag not already present
        run: python3 ./.github/workflows/get_npm_version.py --confirm-tag-not-present

      - name: Create and push tag
        run: python3 ./.github/workflows/get_npm_version.py --push-tag-to-remote

  publish-to-primary:
    name: Publish to Primary Registry
    if: {% raw %}${{ fromJSON(github.event.inputs.publish_to_primary) && github.ref == 'refs/heads/main' }}{% endraw %}
    needs:
      - create-tag
    timeout-minutes: {{ gha_medium_timeout_minutes }}
    runs-on: {{ gha_linux_runner }}
    steps:
      - name: Checkout code
        uses: actions/checkout@{{ gha_checkout }}

      - name: Install dependencies
        uses: ./.github/actions/install_deps
        with:
          node-version: {{ node_version }}
          skip-installing-ssm-plugin-manager: true

      - name: Download built package
        uses: actions/download-artifact@{{ gha_download_artifact }}
        with:
          name: npm-package-dist
          path: dist/

      - name: Validate stable version
        run: |
          BASE=$(npm pkg get version | tr -d '"')
          if [ "$BASE" != "${BASE%%-*}" ]; then
            echo "package.json version '$BASE' contains a prerelease identifier. Set a stable version before publishing to primary." >&2
            exit 1
          fi

{% if npm_package_registry == "AWS CodeArtifact" %}
      - name: OIDC Auth for Publishing to CodeArtifact Primary
        uses: aws-actions/configure-aws-credentials@{{ gha_configure_aws_credentials }}
        with:
          role-to-assume: arn:aws:iam::{{ aws_central_infrastructure_account_id }}:role/GHA-CA-Primary-{{ repo_name }}
          aws-region: {{ aws_org_home_region }}

      - name: Publish to CodeArtifact Primary
        run: |
          . .devcontainer/code-artifact-auth.sh
          pnpm publish --no-git-checks --ignore-scripts

{% else %}
      - name: Publish to npm (promotes to latest)
        run: pnpm publish --no-git-checks --ignore-scripts{% if is_open_source %} --access public{% endif %}

{% endif %}

  install-from-primary:
    name: Install package from primary registry
    if: {% raw %}${{ fromJSON(github.event.inputs.publish_to_primary) && github.ref == 'refs/heads/main' }}{% endraw %}
    needs:
      - publish-to-primary
      - get-values
    strategy:
      matrix:
        os:
          - "{{ gha_linux_runner }}"
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    timeout-minutes: {{ gha_medium_timeout_minutes }}
    steps:
      - name: Checkout code
        uses: actions/checkout@{{ gha_checkout }}

      - name: Install dependencies
        uses: ./.github/actions/install_deps
        with:
          node-version: {{ node_version }}
          skip-installing-ssm-plugin-manager: true

{% if npm_package_registry == "npm" %}
      - name: Wait for npm and install via pnpm
        shell: bash
        run: |
          set -euo pipefail
          PKG="{{ npm_package_name }}"
          VER="{% raw %}${{ needs.get-values.outputs.package-version }}{% endraw %}"
          TESTDIR="$RUNNER_TEMP/primary-test"
          mkdir -p "$TESTDIR"
          printf '{"name":"smoke-test","version":"0.0.0","private":true,"dependencies":{"%s":"%s"}}' "$PKG" "$VER" > "$TESTDIR/package.json"
          for i in $(seq 1 60); do
            code="$(curl -fsS -o /dev/null -w '%{http_code}' "https://registry.npmjs.org/${PKG}/${VER}" || true)"
            if [ "$code" = "200" ]; then
              echo "Found ${PKG}@${VER} on npm."
              break
            fi
            echo "Not yet available (attempt $i/60); sleeping 5s..."
            sleep 5
          done
          if [ "$code" != "200" ]; then
            echo "Timeout waiting for ${PKG}@${VER} on npm."
            exit 1
          fi
          cd "$TESTDIR"
          for i in $(seq 1 12); do
            if pnpm install --no-frozen-lockfile --ignore-scripts; then
              echo "Successfully installed ${PKG}@${VER}"
              break
            fi
            echo "Package not yet installable (attempt $i/12); sleeping 10s..."
            sleep 10
          done
          if [ ! -d "node_modules/${PKG}" ]; then
            echo "Timeout waiting for ${PKG}@${VER} to be installable."
            exit 1
          fi

{% else %}
      - name: OIDC Auth for Installing from CodeArtifact Primary
        uses: aws-actions/configure-aws-credentials@{{ gha_configure_aws_credentials }}
        with:
          role-to-assume: arn:aws:iam::{{ aws_central_infrastructure_account_id }}:role/GHA-CA-Primary-{{ repo_name }}
          aws-region: {{ aws_org_home_region }}

      - name: Install from CodeArtifact Primary
        shell: bash
        run: |
          set -euo pipefail
          . .devcontainer/code-artifact-auth.sh
          PKG="{{ npm_package_name }}"
          VER="{% raw %}${{ needs.get-values.outputs.package-version }}{% endraw %}"
          TESTDIR="$RUNNER_TEMP/primary-test"
          mkdir -p "$TESTDIR"
          printf '{"name":"smoke-test","version":"0.0.0","private":true,"dependencies":{"%s":"%s"}}' "$PKG" "$VER" > "$TESTDIR/package.json"
          cd "$TESTDIR"
          pnpm install --no-frozen-lockfile --ignore-scripts

{% endif %}
      - name: Confirm module version and all export entries
        shell: bash
        run: |
          set -euo pipefail
          VER="{% raw %}${{ needs.get-values.outputs.package-version }}{% endraw %}"
          PKG_DIR="$RUNNER_TEMP/primary-test/node_modules/{{ npm_package_name }}"
          INSTALLED=$(node -e "console.log(require('$PKG_DIR/package.json').version)")
          echo "Installed version: $INSTALLED (expected $VER)"
          if [ "$INSTALLED" != "$VER" ]; then
            echo "Version mismatch"
            exit 1
          fi
          # A publish can succeed while the tarball omits files, so assert every exports target is present.
          while IFS= read -r f; do
            if [ ! -f "$PKG_DIR/$f" ]; then
              echo "Missing export entry: $f — tarball is incomplete"
              exit 1
            fi
            echo "OK: $f"
          done < <(jq -r '.exports | to_entries[] | .value.import | ltrimstr("./")' "$PKG_DIR/package.json")
